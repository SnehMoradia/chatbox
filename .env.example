# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5174
NODE_ENV=development

# Database Configuration
# Leave empty to automatically use built-in MongoDB Memory Server with instant sample seed data!
# Or set to your local or Atlas URI: mongodb://127.0.0.1:27017/teams-chat
MONGODB_URI=

# Authentication (JWT)
JWT_SECRET=teams_chat_ultra_secure_jwt_secret_token_key_2026
JWT_EXPIRES_IN=7d

# GIF API Configuration (Optional: Curated fallback GIFs provided out-of-the-box)
GIPHY_API_KEY=

# Cloudinary Storage Configuration (Optional: Local /uploads folder storage provided out-of-the-box)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
